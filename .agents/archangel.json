{
  "version": 1,
  "gate": {
    "testFileGlobs": [
      "tests/**/*.spec.ts"
    ],
    "testDataGlobs": [
      "tests/fixtures.ts",
      "tests/helpers.ts",
      "tests/global-setup.ts",
      "tests/in-page/**"
    ],
    "testBuildCmd": "npx tsc --noEmit",
    "baseTestCmd": "npx playwright test --workers=4 tests/helpers.spec.ts ${ARCHANGEL_NEW_TEST_FILES:-}",
    "testCmd": "npm run build && npx playwright test --workers=4 tests/helpers.spec.ts ${ARCHANGEL_NEW_TEST_FILES:-}",
    "protectedPaths": [
      "package.json",
      "package-lock.json",
      "tsconfig.json",
      "vite.config.ts",
      "playwright.config.ts",
      "index.html"
    ]
  },
  "requiredChecks": [
    "Gate",
    "Test"
  ],
  "scouts": [
    {
      "name": "bug-hunt",
      "schedule": "daily",
      "maxProposals": 2,
      "skills": [
        "general/bug-hunt",
        "general/input-validation",
        "typescript/*"
      ]
    }
  ],
  "landing": {
    "bugfix": "autonomous"
  },
  "escalations": {
    "factoryRetry": "once"
  },
  "fleetScouts": {
    "optOut": [
      "fleet-pr-miner"
    ]
  },
  "preview": {
    "kind": "web",
    "install": [
      "npm",
      "ci"
    ],
    "start": [
      "sh",
      "-c",
      "node node_modules/vite/bin/vite.js build && exec node node_modules/vite/bin/vite.js preview --host 127.0.0.1 --port 4173 --strictPort"
    ],
    "port": 4173,
    "readyPath": "/",
    "shots": [],
    "allowInstallScripts": false
  }
}
