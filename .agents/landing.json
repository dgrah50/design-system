{
  "requiredChecks": ["Gate", "Test"],
  "gate": {
    "maxNonTestLines": 150,
    "maxTotalLines": 300,
    "maxFiles": 5,
    "extraProtectedPaths": [
      "package.json",
      "package-lock.json",
      "tsconfig.json",
      "vite.config.ts",
      "playwright.config.ts",
      "index.html"
    ],
    "testFileGlobs": ["tests/**/*.spec.ts"],
    "testDataGlobs": ["tests/fixtures.ts", "tests/helpers.ts", "tests/global-setup.ts", "tests/in-page/**"],
    "testBuildCmd": "npx tsc --noEmit",
    "baseTestCmd": "npx playwright test",
    "testCmd": "npm run build && npx playwright test",
    "baseTestRuns": 1,
    "headTestRuns": 1
  }
}
